{
  "uid": "amnezia-control-panel",
  "title": "Amnezia Control Panel",
  "description": "VPN runtime, HTTP, JVM and application errors. Empty peer graphs are expected before devices exist or while VPN is unavailable.",
  "tags": [
    "amnezia",
    "vpn"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "VPN availability",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_server_up{job=\"amnezia-control-panel\"}",
          "legendFormat": "VPN",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "up{job=\"amnezia-control-panel\"}",
          "legendFormat": "Backend scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Peers",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_peers_total{job=\"amnezia-control-panel\"}",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "vpn_peers_active{job=\"amnezia-control-panel\"}",
          "legendFormat": "Active",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Peer traffic — received",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_peer_rx_bytes{job=\"amnezia-control-panel\"}",
          "legendFormat": "{{peer_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Peer traffic — sent",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_peer_tx_bytes{job=\"amnezia-control-panel\"}",
          "legendFormat": "{{peer_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Seconds since last handshake",
      "type": "timeseries",
      "description": "Peers without a handshake are shown in the separate counter. Labels contain managed device IDs only.",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (vpn_peer_last_handshake_timestamp{job=\"amnezia-control-panel\"} > 0)",
          "legendFormat": "{{peer_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Peers without a handshake",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(vpn_peer_last_handshake_timestamp{job=\"amnezia-control-panel\"} == 0) or vector(0)",
          "legendFormat": "No handshake",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP requests by status",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"amnezia-control-panel\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP errors",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"amnezia-control-panel\",status=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "HTTP average latency",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"amnezia-control-panel\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"amnezia-control-panel\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "Mean",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Application errors",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ssh_errors_total{job=\"amnezia-control-panel\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "ssh_errors_total",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(vpn_apply_errors_total{job=\"amnezia-control-panel\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "vpn_apply_errors_total",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(db_errors_total{job=\"amnezia-control-panel\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "db_errors_total",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(vpn_rollback_errors_total{job=\"amnezia-control-panel\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "vpn_rollback_errors_total",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "JVM heap",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"amnezia-control-panel\",area=\"heap\"})",
          "legendFormat": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{job=\"amnezia-control-panel\",area=\"heap\"})",
          "legendFormat": "Committed",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{job=\"amnezia-control-panel\",area=\"heap\"})",
          "legendFormat": "Max",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Process / JVM memory",
      "type": "timeseries",
      "description": "RSS depends on the runtime exporter. Standard Micrometer always supplies JVM heap, non-heap and buffer metrics; these do not include all native process allocations.",
      "datasource": {
        "type": "prometheus",
        "uid": "acp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_rss_bytes{job=\"amnezia-control-panel\"}",
          "legendFormat": "Process RSS (when exported)",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_used_bytes{job=\"amnezia-control-panel\"})",
          "legendFormat": "JVM used",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(jvm_buffer_memory_used_bytes{job=\"amnezia-control-panel\"})",
          "legendFormat": "JVM buffers",
          "datasource": {
            "type": "prometheus",
            "uid": "acp-prometheus"
          }
        }
      ]
    },

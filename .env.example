# Copy to .env; replace empty values locally. Never commit the resulting file.
# Independent base64-encoded 32-byte random keys (openssl rand -base64 32).
JWT_SECRET=
ENCRYPTION_KEY=
PUBLIC_URL=https://panel.example.com
BOOTSTRAP_ADMIN_NICKNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# VPN servers are added by administrators in the UI; no VPN credentials in CI/environment.
ACCESS_TTL=PT15M
REFRESH_TTL=P30D
CONFIG_LINK_TTL=PT1H

# Independent random 32-byte hex token (openssl rand -hex 32), only for metrics.
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
# Dedicated ignored file containing TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
TELEGRAM_ENV_FILE=./secrets/telegram.env

FRONTEND_PORT=5173

# Production overlay: DNS names pointing to the application VPS, without scheme.
# PUBLIC_URL=https://<PANEL_HOST>; GRAFANA_ROOT_URL=https://<GRAFANA_HOST>
PANEL_HOST=panel.example.com
GRAFANA_HOST=grafana.example.com
GRAFANA_EXECUTE_ALERTS=false
# Optional trusted Ubuntu package mirror for runtime image builds; signatures stay verified.
UBUNTU_MIRROR=

# Copy to .env; replace empty values locally. Never commit the resulting file.
# Independent base64-encoded 32-byte random keys (openssl rand -base64 32).
JWT_SECRET=
ENCRYPTION_KEY=
PUBLIC_URL=https://panel.example.com
BOOTSTRAP_ADMIN_NICKNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Compose paths on the host, outside the image.
SSH_KEY_FILE=./secrets/id_ed25519
SSH_KNOWN_HOSTS_FILE=./secrets/known_hosts
VDS_HOST=your-vds.example.com
VDS_PORT=22
VDS_USERNAME=root
AWG_CONTAINER=amnezia-awg
AWG_INTERFACE=awg0
# Paths INSIDE the AWG container; set AWG_CONTAINER empty for host installation.
AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
AWG_PUBLIC_KEY_PATH=/opt/amnezia/awg/wireguard_server_public_key.key
AWG_PSK_PATH=/opt/amnezia/awg/wireguard_psk.key
VPN_SUBNET=10.8.1.0/24
VPN_ENDPOINT=your-vds.example.com:51820
VPN_DNS=1.1.1.1, 1.0.0.1
VPN_ALLOWED_IPS=0.0.0.0/0, ::/0
HANDSHAKE_THRESHOLD=PT3M
ACCESS_TTL=PT15M
REFRESH_TTL=P30D
CONFIG_LINK_TTL=PT1H
SSH_TIMEOUT=PT20S
VPN_POLL_DELAY=30000

# Independent random 32-byte hex token (openssl rand -hex 32), only for metrics.
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000


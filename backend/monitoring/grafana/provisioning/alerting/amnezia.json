{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "Amnezia Telegram",
      "receivers": [
        {
          "uid": "acp-telegram",
          "type": "telegram",
          "disableResolveMessage": false,
          "settings": {
            "bottoken": "$TELEGRAM_BOT_TOKEN",
            "chatid": "$TELEGRAM_CHAT_ID",
            "parse_mode": "HTML",
            "disable_web_page_preview": true,
            "message": "{{ range .Alerts -}}\n{{ if eq .Status \"resolved\" }}🟢 <b>Восстановлено</b>{{ else if eq .Labels.severity \"warning\" }}🟡 <b>Предупреждение</b>{{ else }}🔴 <b>Проблема</b>{{ end }} · Amnezia\n{{ if and (eq .Status \"resolved\") .Annotations.recovery }}{{ .Annotations.recovery | html }}{{ else if .Annotations.summary }}{{ .Annotations.summary | html }}{{ else }}{{ .Labels.alertname | html }}{{ end }}\n{{ if .PanelURL }}<a href=\"{{ .PanelURL | html }}\">Открыть график →</a>{{ else if .DashboardURL }}<a href=\"{{ .DashboardURL | html }}\">Открыть дашборд →</a>{{ else }}<a href=\"{{ .GeneratorURL | html }}\">Подробнее →</a>{{ end }}\n\n{{ end -}}"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "Amnezia Telegram",
      "group_by": [
        "alertname",
        "instance"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "routes": [
        {
          "receiver": "Amnezia Telegram",
          "object_matchers": [
            [
              "alertname",
              "=",
              "DatasourceError"
            ]
          ],
          "group_by": [
            "alertname",
            "datasource_uid"
          ],
          "group_wait": "1m",
          "group_interval": "5m",
          "repeat_interval": "4h"
        }
      ]
    }
  ],
  "groups": [
    {
      "orgId": 1,
      "name": "Amnezia health",
      "folder": "Amnezia",
      "interval": "30s",
      "rules": [
        {
          "uid": "acp-application-down",
          "title": "Application unavailable",
          "condition": "B",
          "for": "2m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "labels": {
            "service": "amnezia-control-panel",
            "component": "application",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Приложение недоступно",
            "description": "Prometheus не может получить метрики более 2 минут. Проверьте backend, сеть и METRICS_TOKEN.",
            "__dashboardUid": "amnezia-control-panel",
            "__panelId": "1",
            "recovery": "Приложение снова доступно"
          },
          "dashboardUid": "amnezia-control-panel",
          "panelId": 1,
          "data": [
            {
              "refId": "A",
              "datasourceUid": "acp-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "acp-prometheus"
                },
                "expr": "max by (job,instance) (up{job=\"amnezia-control-panel\"} == bool 0)",
                "instant": true,
                "range": false,
                "format": "time_series",
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "acp-vpn-down",
          "title": "VPN unavailable",
          "condition": "B",
